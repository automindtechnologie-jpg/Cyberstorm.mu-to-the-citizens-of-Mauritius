# ─────────────────────────────────────────────────
# Cyberstorm.mu Petition Platform — Environment Config
# Copy this file to .env and fill your own values
# ─────────────────────────────────────────────────

# Secret token embedded in the petition form URL
# Share the full link: https://your-domain/?t=THIS_VALUE
PETITION_TOKEN=CHANGE_ME_generate_with_script_below

# Password to access the dashboard at /dashboard
DASHBOARD_PASSWORD=CHANGE_ME_strong_password

# Random secret for session signing — keep private
SESSION_SECRET=CHANGE_ME_64_random_chars

# Internal port (default 3000 — do not change unless you know why)
PORT=3000

# ─────────────────────────────────────────────────
# Generate secure values with:
#
# node -e "
#   const c=require('crypto');
#   console.log('PETITION_TOKEN='+c.randomBytes(18).toString('base64url'));
#   console.log('DASHBOARD_PASSWORD='+c.randomBytes(14).toString('base64url'));
#   console.log('SESSION_SECRET='+c.randomBytes(32).toString('base64url'));
# "
# ─────────────────────────────────────────────────
